{
  "name": "@marko/vite",
  "version": "6.1.14",
  "description": "A Marko plugin for Vite",
  "keywords": [
    "loader",
    "marko",
    "plugin",
    "transform",
    "vite"
  ],
  "homepage": "https://github.com/marko-js/vite",
  "bugs": "https://github.com/marko-js/vite/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/marko-js/vite"
  },
  "license": "MIT",
  "author": "Dylan Piercey <dpiercey@ebay.com>",
  "main": "./dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b && tsx build.mts",
    "change": "changeset add",
    "ci:test": "nyc pnpm test --forbid-only",
    "format": "pnpm run lint:eslint --fix && pnpm run lint:prettier --write",
    "lint": "tsc -b && pnpm run lint:eslint && pnpm run lint:prettier -l",
    "lint:eslint": "eslint -f unix .",
    "lint:prettier": "prettier \"./**/*{.ts,.js,.json,.md,.yml,rc}\"",
    "prepare": "husky",
    "release": "pnpm run build && changeset publish --tag ${NPM_CONFIG_TAG:-latest}",
    "report": "open ./coverage/lcov-report/index.html",
    "test": "cross-env NODE_ENV=test mocha \"./src/**/__tests__/*.test.ts\"",
    "test:inspect": "pnpm test --inspect",
    "test:update": "pnpm test --update",
    "version": "changeset version && pnpm install --lockfile-only"
  },
  "dependencies": {
    "@chialab/estransform": "^0.20.1",
    "anymatch": "^3.1.3",
    "domelementtype": "^3.0.0",
    "domhandler": "^6.0.1",
    "fast-glob": "^3.3.3",
    "htmljs-parser": "^5.22.1",
    "htmlparser2": "^12.0.0",
    "relative-import-path": "^1.0.1",
    "resolve-sync": "^1.3.0",
    "resolve.exports": "^2.0.4"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@marko/compiler": "^5.43.3",
    "@marko/fixture-snapshots": "^2.2.1",
    "@marko/testing-library": "^6.4.2",
    "@types/babel__core": "^7.20.5",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/serve-handler": "^6.1.4",
    "cross-env": "^10.1.0",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "less": "^4.9.1",
    "lint-staged": "^17.6.0",
    "marko": "^5.40.3",
    "mocha": "^12.0.3",
    "mocha-snap": "^5.0.1",
    "nyc": "^18.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-packagejson": "^3.1.0",
    "serve-handler": "^6.1.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "@marko/compiler": "^5",
    "vite": "^8"
  },
  "packageManager": "pnpm@11.15.1"
}
