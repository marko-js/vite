import { onlyServer } from "./server-only.js";
import { impureServerOnly } from "impure-lib";
import { serverOnlyStyle } from "./server-styles.css.js";
import { shared } from "./shared.js";
import { loaded } from "./tracker.js";
import "./explicit-side-effect.js";
import "side-effect-lib";
import "./styles.css";

// `onlyServer`/`impureServerOnly`/`serverOnlyStyle` are used only in a server
// block, so nothing references them in the client build. Unlinked, that is not
// enough to drop them: their modules still run for their side effects.
server {
  onlyServer();
  impureServerOnly();
  serverOnlyStyle();
}

<div.marko-side-effects>
  <div id="shared">shared: ${shared}</div>
  <div id="loaded">loaded: ${loaded.slice().sort().join(", ")}</div>
</div>
